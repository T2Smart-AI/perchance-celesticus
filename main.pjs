// Celestia Web — real-time 3D space visualization for Perchance.
// A native WebGL re-implementation inspired by Celestia (CelestiaProject/Celestia).

$meta
  title = Celestia Web — 3D Space Voyage
  description = Fly through the solar system and the stars: real ephemerides, time warp, constellations, guided tour.
  tags = space, astronomy, 3d, planets, stars, educational, simulation

config
  appName = Celestia Web

